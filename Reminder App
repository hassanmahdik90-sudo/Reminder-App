<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RemindMe - Task & Reminder App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: '#06b6d4'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">

    <!-- Header -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 shadow-sm sticky top-0 z-10">
        <div class="max-w-2xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-2.5">
                <div class="w-9 h-9 bg-cyan-500 rounded-xl flex items-center justify-center text-white shadow-md">
                    <i class="fa-solid fa-square-check text-lg"></i>
                </div>
                <h1 class="text-xl font-extrabold tracking-tight">RemindMe</h1>
            </div>
            <button id="theme-toggle" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-slate-600 transition">
                <i class="fa-solid fa-moon"></i>
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-2xl w-full mx-auto p-4 md:p-6 flex-grow space-y-6">

        <!-- Add Reminder Form -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
            <h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                New Reminder
            </h2>

            <form id="reminder-form" class="space-y-3">
                <input type="text" id="reminder-title" placeholder="What do you need to remember?" required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl px-4 py-3 text-sm font-semibold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500">
                
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                    <input type="date" id="reminder-date" required class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl px-3 py-2.5 text-xs font-semibold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500">
                    
                    <select id="reminder-category" class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl px-3 py-2.5 text-xs font-semibold text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500">
                        <option value="Personal">Personal</option>
                        <option value="Work">Work</option>
                        <option value="Urgent">Urgent</option>
                    </select>

                    <button type="submit" class="bg-cyan-500 hover:bg-cyan-600 text-white font-extrabold py-2.5 px-4 rounded-2xl transition shadow-md flex items-center justify-center gap-2 text-xs">
                        <i class="fa-solid fa-plus"></i>
                        Add Reminder
                    </button>
                </div>
            </form>
        </div>

        <!-- Filter Tabs -->
        <div class="flex items-center space-x-1.5 overflow-x-auto pb-1 text-xs font-extrabold">
            <button onclick="setFilter('all')" id="filter-all" class="filter-btn px-4 py-2 rounded-2xl bg-cyan-500 text-white shadow-sm transition">All</button>
            <button onclick="setFilter('today')" id="filter-today" class="filter-btn px-4 py-2 rounded-2xl bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 transition">Today</button>
            <button onclick="setFilter('upcoming')" id="filter-upcoming" class="filter-btn px-4 py-2 rounded-2xl bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 transition">Upcoming</button>
            <button onclick="setFilter('completed')" id="filter-completed" class="filter-btn px-4 py-2 rounded-2xl bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 transition">Completed</button>
        </div>

        <!-- Reminders List -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-3">
            <div id="reminders-container" class="space-y-3">
                <!-- Dynamic Items -->
            </div>

            <div id="no-reminders" class="text-center py-8 text-xs text-slate-400 dark:text-slate-500 italic">
                No reminders found.
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="max-w-2xl w-full mx-auto px-4 py-4 text-center text-xs text-slate-400 mt-auto">
        Single-File Web App &bull; LocalStorage Persistence &bull; MIT License
    </footer>

    <!-- Application Logic -->
    <script>
        // State
        let reminders = JSON.parse(localStorage.getItem('app_reminders')) || [];
        let activeFilter = 'all';

        // Elements
        const reminderForm = document.getElementById('reminder-form');
        const titleInput = document.getElementById('reminder-title');
        const dateInput = document.getElementById('reminder-date');
        const categoryInput = document.getElementById('reminder-category');
        const container = document.getElementById('reminders-container');
        const noRemindersEl = document.getElementById('no-reminders');
        const themeToggleBtn = document.getElementById('theme-toggle');

        // Set default date input to today
        dateInput.value = new Date().toISOString().split('T')[0];

        // Dark Mode
        themeToggleBtn.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            themeToggleBtn.innerHTML = isDark ? '<i class="fa-solid fa-sun"></i>' : '<i class="fa-solid fa-moon"></i>';
        });

        // Add Reminder
        reminderForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const title = titleInput.value.trim();
            const date = dateInput.value;
            const category = categoryInput.value;

            if (!title || !date) return;

            const newItem = {
                id: Date.now(),
                title,
                date,
                category,
                completed: false
            };

            reminders.push(newItem);
            saveAndRender();

            titleInput.value = '';
            dateInput.value = new Date().toISOString().split('T')[0];
        });

        function saveAndRender() {
            localStorage.setItem('app_reminders', JSON.stringify(reminders));
            renderReminders();
        }

        function toggleComplete(id) {
            reminders = reminders.map(r => r.id === id ? { ...r, completed: !r.completed } : r);
            saveAndRender();
        }

        function deleteReminder(id) {
            reminders = reminders.filter(r => r.id !== id);
            saveAndRender();
        }

        function setFilter(filter) {
            activeFilter = filter;
            
            // Update filter button styles
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.className = 'filter-btn px-4 py-2 rounded-2xl bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 transition';
            });
            
            const activeBtn = document.getElementById(`filter-${filter}`);
            if (activeBtn) {
                activeBtn.className = 'filter-btn px-4 py-2 rounded-2xl bg-cyan-500 text-white shadow-sm transition';
            }

            renderReminders();
        }

        function renderReminders() {
            container.innerHTML = '';

            const todayStr = new Date().toISOString().split('T')[0];

            let filtered = reminders.filter(r => {
                if (activeFilter === 'completed') return r.completed;
                if (activeFilter === 'today') return r.date === todayStr && !r.completed;
                if (activeFilter === 'upcoming') return r.date > todayStr && !r.completed;
                return true; // 'all'
            });

            if (filtered.length === 0) {
                noRemindersEl.classList.remove('hidden');
                return;
            }

            noRemindersEl.classList.add('hidden');

            // Sort by Date
            filtered.sort((a, b) => a.date.localeCompare(b.date));

            filtered.forEach(r => {
                const card = document.createElement('div');
                const isOverdue = r.date < todayStr && !r.completed;

                let categoryColor = 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300';
                if (r.category === 'Work') categoryColor = 'bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300';
                if (r.category === 'Urgent') categoryColor = 'bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-300';

                card.className = `flex items-center justify-between p-4 rounded-2xl border transition ${
                    r.completed
                        ? 'bg-slate-50 dark:bg-slate-900/40 border-slate-100 dark:border-slate-800 opacity-50'
                        : isOverdue
                        ? 'bg-rose-50/50 dark:bg-rose-950/20 border-rose-200 dark:border-rose-800'
                        : 'bg-slate-50/50 dark:bg-slate-900/50 border-slate-100 dark:border-slate-700/50'
                }`;

                card.innerHTML = `
                    <div class="flex items-center space-x-3.5 min-w-0 pr-2">
                        <button onclick="toggleComplete(${r.id})" class="w-6 h-6 rounded-lg border-2 flex items-center justify-center transition flex-shrink-0 ${
                            r.completed 
                                ? 'bg-cyan-500 border-cyan-500 text-white' 
                                : 'border-slate-300 dark:border-slate-600 hover:border-cyan-500'
                        }">
                            ${r.completed ? '<i class="fa-solid fa-check text-xs"></i>' : ''}
                        </button>
                        <div class="space-y-0.5 truncate">
                            <p class="text-xs font-extrabold text-slate-800 dark:text-slate-100 truncate ${r.completed ? 'line-through' : ''}">
                                ${r.title}
                            </p>
                            <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400">
                                <span><i class="fa-regular fa-calendar mr-1"></i>${r.date}</span>
                                ${isOverdue ? '<span class="text-rose-500 font-extrabold">&bull; Overdue</span>' : ''}
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2 flex-shrink-0">
                        <span class="px-2.5 py-1 rounded-xl text-[10px] font-extrabold uppercase tracking-wider ${categoryColor}">
                            ${r.category}
                        </span>
                        <button onclick="deleteReminder(${r.id})" class="text-slate-400 hover:text-rose-500 transition p-1">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Inline Global Event Handlers
        window.toggleComplete = toggleComplete;
        window.deleteReminder = deleteReminder;
        window.setFilter = setFilter;

        // Initial Load
        renderReminders();
    </script>
</body>
</html>
